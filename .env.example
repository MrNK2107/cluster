# Copy to .env for local development. `.env` is git-ignored; never commit real values.
#
# Both values come from Supabase → Project Settings → API. Use the *anon /
# publishable* key only. The service_role / secret key must never be used in
# a browser app (the settings form rejects it anyway).
#
# Leave both empty to run fully offline. Users can still connect their own
# project from the Cloud sync dialog.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
